# Watchdog status service (backend) configuration
# Copy to .env and edit:  cp .env.example .env
# Then run:  .venv/bin/python -m uvicorn watchdog_api:app --env-file .env
#
# NOTE: these vars configure the BACKEND only. The desktop plugin has exactly
# one config value of its own — WATCHDOG_BACKEND_URL inside plugin.js
# (see README "Plugin install").

# Bind address for the FastAPI service. Default 127.0.0.1 — keep it on a
# private interface; only widen (e.g. 0.0.0.0) behind Tailscale or a trusted LAN.
WATCHDOG_HOST=127.0.0.1

# Port. Default 8766.
WATCHDOG_PORT=8766

# Hermes home: where scripts/, lcm.db, cron/jobs.json live. Default ~/.hermes.
HERMES_HOME=~/.hermes

# Disk usage warning threshold (percent). Default 80.
DAILY_DISK_ALERT_PCT=80
